# Copy to .env and fill in. .env is gitignored.

# From @BotFather. Keep it secret: anyone with it controls your bot.
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id. Leave empty, run the bot, send /start, and it replies with your id.
TELEGRAM_OWNER_ID=

# How your messages become booking jobs:
#   rules  = free, runs on your laptop (default)
#   claude = Claude API, paid per message, needs ANTHROPIC_API_KEY and credit
INTAKE=rules
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Defaults
BMS_CITY=vellore
POLL_SECONDS=60
# After this many identical fallback answers in a row, the agent stops asking and applies it.
LEARN_AFTER=2
